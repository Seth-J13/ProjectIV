DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=speckit-db
DB_PORT=3306
AUTH_SECRET=change-me-in-production
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
# OAuth Web client from Google Developer Console. Same client ID as VITE_GOOGLE_CLIENT_ID.
# Do not commit real values. Put them in backend/.env (gitignored).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
